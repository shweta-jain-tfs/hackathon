          IsAnyHighPriority="@ViewModel.IsAnyHighPriority"
          HighPriorityText="@Loc["Legend_State_HighPriority"]"
          IsAnyManualEntry="@ViewModel.IsAnyManualEntry"
          ManualEntryText="@Loc["Legend_State_ManualEntry"]"
          UnloadRequestedCount="@ViewModel.UnloadRequestedCount"
          UnloadRequestedText="@Loc["Legend_Issue_UnloadRequested"]" />
