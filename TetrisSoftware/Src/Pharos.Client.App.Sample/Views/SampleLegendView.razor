@namespace Pharos.Client.App.Sample.Views
@using Pharos.Client.App.Sample.ViewModels
@using Pharos.Common.Web.Components.Legend

<PhLegend TStatus="TubeStatus"
          @ref="_phLegend"
          StatusHeaderText="@Loc["Legend_State_Header"]"
          LegendStatuses="ViewModel.LegendStatuses"
          GetStatusText="@SampleLegendViewModel.GetSampleTubeStatusText"
          SelectionChanged="@ViewModel.OnLegendSelectionChanged"
          ErrorHeaderText="@Loc["Legend_Issue_Header"]"
