<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Configurations Condition="'$(MSBuildProjectName)' == 'Pharos.Client' Or '$(MSBuildProjectName)' == 'Pharos.Client.Common.App'">Debug;Release;Debug1080p</Configurations>
		<ClsCompliant>true</ClsCompliant>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>All</AnalysisMode>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug1080p'">
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DisableImplicitConfigurationDefines>true</DisableImplicitConfigurationDefines>
		<DefineConstants>$(DefineConstants);DEBUG;DEBUG_1080P</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
	</PropertyGroup>
</Project>
