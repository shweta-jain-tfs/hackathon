{
  "ConnectionStrings": {
    "Default": "Server=localhost;TrustServerCertificate=True;Trusted_Connection=True;Database=Pharos;MultipleActiveResultSets=True;Column Encryption Setting=Enabled;Attestation Protocol=None;",
    "Audit": "Server=localhost;TrustServerCertificate=True;Trusted_Connection=True;Database=AuditTrail;MultipleActiveResultSets=True;"
  },
  "Certificates": {
    "DefaultServerName": "pharos.local",
    "AllowWildcardCertificates": true,
    "ColumnMasterKeyLifetimeDays": 730,
    "UseTpm": false
  },
  "Kestrel": {
    "Endpoints": {
      // The internal web endpoint is used for primarily for displaying Pharos UI on the instrument screens.
      "InternalWeb": {
        "Url": "https://0.0.0.0",
        "Protocols": "Http1AndHttp2"
      },
      // The external web endpoint should be used to access Pharos from outside the firewall (from the lab network).
      // We need a separate endpoint for this because it may have lab's certificate uploaded to Pharos.
      "ExternalWeb": {
        "Url": "https://0.0.0.0:444",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "DataProtection": {
    "EnableDataProtection": false
  },
  "Logging": {
    "Grpc": {
      "BinaryMessages": false
    }
  }
}
