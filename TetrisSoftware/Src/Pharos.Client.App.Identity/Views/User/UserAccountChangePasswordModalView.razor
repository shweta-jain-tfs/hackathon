@using Pharos.Client.Common.App.Validation
@using Pharos.Client.Common.Localization
@using Pharos.Contracts.Security

<PhModalContent>
    <Body>
        <PhSimpleValidationContext @ref="_validation" Model="ViewModel" OnValidationStateChanged="StateHasChanged">
            <PhInputColumn Spacing="InputSpacing.Default">
                <PhTextBox Label="@Loc["UserAccountPage_ChangePassword_CurrentPassword"]"
                           @bind-Value="ViewModel.CurrentPassword"
                           PlaceHolder="@Loc["ApplicationUsersPage_AddDialog_PasswordPlaceholder"]"
                           Size="TextBoxSize.Medium"
                           Type="TextBoxType.Password" />

                <PhTextBox Label="@Loc["UserAccountPage_ChangePassword_NewPassword"]"
                           @bind-Value="ViewModel.NewPassword"
                           PlaceHolder="@Loc["ApplicationUsersPage_AddDialog_PasswordPlaceholder"]"
                           Size="TextBoxSize.Medium"
                           Type="TextBoxType.Password" />

                <PhTextBox Label="@Loc["UserAccountPage_ChangePassword_ConfirmPassword"]"
                           @bind-Value="ViewModel.ConfirmPassword"
                           PlaceHolder="@Loc["ApplicationUsersPage_AddDialog_PasswordPlaceholder"]"
                           Size="TextBoxSize.Medium"
                           Type="TextBoxType.Password" />

                @if (_passwordComplexityList != null && _passwordComplexityList.Any())
                {
                    <PhValueBox Size="TextBoxSize.Default">
                        @foreach (var complexityString in _passwordComplexityList)
                        {
                            @complexityString
                            @if (complexityString != _passwordComplexityList.Last())
                            {
                                <br />
                            }
                        }
                    </PhValueBox>
                }
            </PhInputColumn>
        </PhSimpleValidationContext>
    </Body>
    <Footer>
        <PhButton OnClick="@(() => CloseModal(ModalResult.Cancel()))">@Loc["ApplicationUsersPage_AddDialog_ButtonSecondary"]</PhButton>
        <PhButton Type="ButtonType.Primary" OnClick="@Save" Disabled="@IsSaveDisabled()">@Loc["UsersAndRolePage_Save"]</PhButton>
    </Footer>
</PhModalContent>
