<?xml version="1.0" encoding="utf-8"?>

<configuration>
	<packageSources>
		<clear />
		<add key="NuGet" value="https://api.nuget.org/v3/index.json" />
		<add key="Pharos" value="https://idd-devops-p1.emea.thermo.com/DevelopmentCollection/TetrisSoftware/_packaging/pharos-nuget-feed/nuget/v3/index.json" />
		<!--<add key="Nuget JFrog" value="https://thermofisher.jfrog.io/artifactory/api/nuget/v3/tetris-software-nuget-internal/index.json" />-->
	</packageSources>

	<packageSourceMapping>
		<packageSource key="NuGet">
			<package pattern="*" />
		</packageSource>
		<packageSource key="Pharos">
			<package pattern="Tetris.Protocol.*" />
			<package pattern="LabCommunity.API.Client" />
		</packageSource>
	</packageSourceMapping>
</configuration>