@startuml ClosingSampleDrawer
skinparam BoxPadding 20

actor User as user

box "Instrument" #LightGrey
	participant Pharos.Gui #LightSkyBlue
	participant gRPC
end box

box "Pharos-Server" #LightSkyBlue
	participant Application.Instrument
	participant Application.Infrastructure
end box

'Scan one Sample'
user -> gRPC : Push Unlock Button

'Send lock open'
gRPC -> Application.Instrument : grpc LockOpen
Application.Instrument -> Application.Instrument : Send LockOpenCommand
Application.Instrument -> Application.Instrument : Publish InstrumentStateChangedEvent
note over Application.Instrument: InstrumentStateChangedEventHandler\nlisten on InstrumentStateChangedEvent.
Application.Instrument -> Application.Infrastructure : _hub.StateChanged()
Application.Infrastructure --> Pharos.Gui

