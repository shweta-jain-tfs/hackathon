@using Pharos.Common.Web.Components.FormElements
@using Pharos.Common.Web.Components.FormElements.Enums
@using Pharos.Stories.Components.TestContent
@attribute [Stories("Components/CheckBox")]

<Stories TComponent="PhCheckBox">
    <Story Name="CheckBox">

        <Template>
            <PhCheckBox Label="Banana" @bind-Value="_banana" @attributes="context.Args"></PhCheckBox>
            <div class="mt-md inline-flex flex-col gap-gutter">
                <PhButton OnClick="() => _banana = !_banana">Toggle from outside</PhButton>
                <span>Current: @_banana</span>
            </div>
        </Template>

    </Story>
    <Story Name="Validation">

        <Template>
            <EditForm Model="@ViewModel" Context="form" @ref="_form">
                <MockValidator @ref="_validator" />
                <ValidationSummary />
                <PhCheckBox @attributes="context.Args" Label="Value 1" @bind-Value="@ViewModel.PropertyOne" />
                <PhCheckBox @attributes="context.Args" Label="Value 2" @bind-Value="@ViewModel.PropertyTwo" LabelHelpText="Change the value to validate" />
            </EditForm>
            <PhButton OnClick="() => _form?.EditContext?.Validate()">Validate</PhButton>
            <PhButton OnClick="() => _validator?.ClearErrors()">Clear errors</PhButton>
        </Template>

    </Story>
</Stories>

@code {
    private bool _banana;
    private Model ViewModel { get; set; } = new Model();
    private EditForm? _form;
    private MockValidator? _validator;

    public class Model
    {
        public bool PropertyOne { get; set; }
        public bool PropertyTwo { get; set; } = true;
    }
}
