    <Story Name="Default">
        <Description>Multiple tables with aligned column widths.</Description>
        <Arguments>
            <Arg For="_ => _!.Columns" Value="@ColumnCount.Five" />
        </Arguments>
        <Template>
            <style>
                th, td {
                    border: 1px dashed gray;
                }
            </style>
            <PhAlignedTables @attributes="context.Args">
                <PhAlignedTableItem Title="Bottles">
