@using Pharos.Common.Web.Components.FormElements
@using Pharos.Common.Web.Components.Modal

<PhModalContent>
    
    <Body>

        <p>This another dialog and it is also a dialog element!</p>
        <PhTextBox Label="The text you add here will be sent to the parent" @bind-Value="@_output" />
    </Body>
    
    <Footer>
        <PhButtonGroup Justified>
            <PhButton OnClick="@(() => Close(ModalResult.Ok(_output)))">Save</PhButton>
            <PhButton OnClick="@(() => Close(ModalResult.Cancel()))">Cancel</PhButton>
        </PhButtonGroup>
    </Footer>

</PhModalContent>

@code
{
    [CascadingParameter] public ModalInstance? Modal { get; set; }

    private string _output = default!;

    private void Close(ModalResult result)
    {
        Modal?.CloseAsync(result);
    }
}
