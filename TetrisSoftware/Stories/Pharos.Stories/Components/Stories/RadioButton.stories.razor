@using Pharos.Common.Web.Components.FormElements
@using Pharos.Common.Web.Components.FormElements.RadioButton
@using Pharos.Stories.Components.TestContent
@attribute [Stories("Components/RadioButton")]

<Stories TComponent="PhRadioGroup<string>">
    <Story Name="Horizontal">
        <Template>
            <PhRadioGroup @attributes="context.Args" IsHorizontal="true" @bind-SelectedValue="SelectedValueFruit">
                <PhRadioButton Value="_radiobutton1" Label="Apple"> </PhRadioButton>
                <PhRadioButton Value="_radiobutton2" Label="Pear"> </PhRadioButton>
                <PhRadioButton Value="_radiobutton3" Label="Banana"> </PhRadioButton>
                <PhRadioButton Value="_radiobutton4" Label="Orange" Disabled="true"> </PhRadioButton>
            </PhRadioGroup>
            Selected value: @SelectedValueFruit
        </Template>
    </Story>

    <Story Name="Vertical">
        <Template>
            <PhRadioGroup @attributes="context.Args" @bind-SelectedValue="SelectedValueFruit">
                <PhRadioButton Value="_radiobutton1" Label="Apple"> </PhRadioButton>
                <PhRadioButton Value="_radiobutton2" Label="Pear (Show extra row when checked)">
                    <div class="flex items-center gap-md">
                        <PhButton OnClick="@OnClickButton">Select Pears...</PhButton>
                        <div class="t-helper-text">None selected</div>
                    </div>
                </PhRadioButton>
                <PhRadioButton Value="_radiobutton3" Label="Banana (Radio buttons inside)">
                    <PhRadioGroup IsHorizontal="true" @bind-SelectedValue="SelectedValueColor">
                        <PhRadioButton Value="_radiobutton11" Label="Blue"> </PhRadioButton>
                        <PhRadioButton Value="_radiobutton12" Label="Red"> </PhRadioButton>
                        <PhRadioButton Value="_radiobutton13" Label="Green"> </PhRadioButton>
                        <PhRadioButton Value="_radiobutton14" Label="Yellow" Disabled="true"> </PhRadioButton>
                    </PhRadioGroup>
                    Selected color: @SelectedValueColor
                </PhRadioButton>
                <PhRadioButton Value="_radiobutton4" Label="Orange" Disabled="true"> </PhRadioButton>
            </PhRadioGroup>
            Selected fruit: @SelectedValueFruit
        </Template>
    </Story>

    <Story Name="Validation">

        <Template>
            <EditForm Model="@ViewModel" Context="form" @ref="_form">
                <MockValidator @ref="_validator" />
                <ValidationSummary />
                <PhRadioGroup IsHorizontal="true" @attributes="context.Args" @bind-SelectedValue="ViewModel.PropertyOne">
                    <PhRadioButton Value="_radiobutton1" Label="Apple" Disabled="true"/>
                    <PhRadioButton Value="_radiobutton2" Label="Pear" />
                    <PhRadioButton Value="_radiobutton3" Label="Banana" />
                    <PhRadioButton Value="_radiobutton4" Label="Orange" />
                </PhRadioGroup>
            </EditForm>
            <PhButton OnClick="() => _form?.EditContext?.Validate()">Validate</PhButton>
            <PhButton OnClick="() => _validator?.ClearErrors()">Clear errors</PhButton>
        </Template>

    </Story>
</Stories>

@code
{
    private string? SelectedValueColor { get; set; }
    private string? SelectedValueFruit { get; set; }

    private readonly string _radiobutton1 = "1 - Apple";
    private readonly string _radiobutton2 = "2 - Pear";
    private readonly string _radiobutton3 = "3 - Banana";
    private readonly string _radiobutton4 = "4 - Orange";
    private readonly string _radiobutton11 = "11 - Blue";
    private readonly string _radiobutton12 = "12 - Red";
    private readonly string _radiobutton13 = "13 - Green";
    private readonly string _radiobutton14 = "14 - Yellow";

    private Model ViewModel { get; set; } = new Model();
    private EditForm? _form;
    private MockValidator? _validator;

    public class Model
    {
        public string? PropertyOne { get; set; }
        public string? PropertyTwo { get; set; }
    }


    private void OnClickButton()
    {
    }
}