    private List<PhChartLinear.IDrawable> LoadContentRU()
    {
        // RU chart is not yet used in Pharos. This needs further development when we know more about the design & requirements.
        // For now it's just another linear chart, just like the CC charts, but with many points. Points have the point state "fast",
        // just like other points can be "warning", "alert" etc. Fast here means optimized for speed in scss. Combinations of fast and other 
        // properties (Selected, Active, Small) has not been explored yet. Neither has miniature RU charts, if needed at all.
        // Also, it's only fast enough for up to about 1000 points in release mode. To improve speed further we may have to try 
        // a canvas instead of individual DOM elements for each point.

        PhChartLinear.Points pointsRU = new PhChartLinear.Points
        {
            PointList = new(),
            FastRendering = true,
            Small = true
        };

        var rnd = new Random();
        var timestep = new TimeSpan(0, 2, 0);
        for (var i = 0; i < 1000; i++)
        {
            var p = new PhChartLinear.Point
            {
                X = _startDate3 + i * timestep,
                Y = rnd.Next(3) > 1 ? Math.Pow(rnd.NextDouble(), 4) * 15000f : 0
            };
            pointsRU.PointList.Add(p.X, new() { p });
        }

        PhChartLinear.HorizontalAxis axisX = new PhChartLinear.HorizontalAxis
        {
            Label = "x (date)",
            DrawAxisLine = false
        };

        PhChartLinear.VerticalAxis axisY = new PhChartLinear.VerticalAxis
        {
            TickDistance = 5000,
            ValueEveryNTicks = 1,
            Label = "y (some unit)",
            DrawAxisLine = false
        };

        var content = new List<PhChartLinear.IDrawable>
        {
            axisX,
            axisY,
            new PhChartLinear.HorizontalLine
            {
                Value = 5000,
                Dashed = true
            },
            new PhChartLinear.HorizontalLine
            {
                Value = 10000,
                Dashed = true
            },
            new PhChartLinear.HorizontalLine
            {
                Value = 15000,
                Dashed = true
            },
            new PhChartLinear.HorizontalLine
            {
                Value = 20000,
                Dashed = true
            },
            new PhChartLinear.HorizontalLine
            {
                Value = 25000,
                Dashed = true
            },
            pointsRU
        };

        return content;
    }

    private void VerticalZoomIn()
