@using Pharos.Common.Web.Components.Charts.ChartBase
@using Pharos.Common.Web.Components.FormElements
@using Pharos.Common.Web.Components.Panel
@using static Pharos.Common.Web.Components.Charts.ChartBase.PhChartLinear
@attribute [Stories("Components/Chart")]

<Stories TComponent="PhChartLinear">
    <Story Name="Linear Chart">
        <Template>
            <PhChartLinear PointClicked="@OnPointClicked" Interactive="true" Content="ContentStandard" ChartWidth="800" ChartHeight="400" DataRangeXMin="@_startDate" DataRangeXMax="@_endDate" DataRangeYMin="0.2" DataRangeYMax="1.2" ></PhChartLinear>
        </Template>
    </Story>

    <Story Name="Linear Chart - miniature">
        <Template>
            <br/>
            <div style="padding-left:100px;">
                <PhChartLinear Interactive="false" Miniature="true" Content="ContentMiniature" ChartWidth="192" ChartHeight="140" DataRangeXMin="@_startDateMini" DataRangeXMax="@_endDateMini" DataRangeYMin="0.2" DataRangeYMax="1.2" @attributes="context.Args"></PhChartLinear>
            </div>
        </Template>
    </Story>

    <Story Name="Linear Chart - dynamic data">
        <Template>
            <PhChartLinear Interactive="true" Content="ContentDynamic" ChartWidth="800" ChartHeight="400" DataRangeXMin="@_startDate" DataRangeXMax="@_endDate" DataRangeYMin="@_dynamicYMin" DataRangeYMax="@_dynamicYMax" @attributes="context.Args"></PhChartLinear>

            <div class="flex flex-row">
                <div>
                    <PhButton OnClick="@(() => VerticalZoomIn())">Vertical zoom in</PhButton>
                    <PhButton OnClick="@(() => VerticalZoomOut())">Vertical zoom out</PhButton>
                </div>
            </div>
            <br/>
            <div class="flex flex-row">
                <PhButton OnClick="@(() => _animating = !_animating)">Mod values</PhButton>
                <div>
                    <PhButton OnClick="@(() => AddPoint())">Add point</PhButton>
                    <PhButton OnClick="@(() => DeletePoint())">Delete point</PhButton>

                </div>
                <div>
                    <PhButton OnClick="@(() => AddLine())">Add line</PhButton>
                    <PhButton OnClick="@(() => DeleteLine())">Delete line</PhButton>

                </div>
                <div>
                    <PhButton OnClick="@(() => AddRegion())">Add region</PhButton>
                    <PhButton OnClick="@(() => DeleteRegion())">Delete region</PhButton>
                </div>
            </div>
        </Template>
    </Story>

    <Story Name="Linear Chart - empty">
        <Template>
            <PhChartLinear PointClicked="@OnPointClicked" Interactive="true" Content="ContentEmpty" ChartWidth="800" ChartHeight="400" DataRangeXMin="@_startDate" DataRangeXMax="@_endDate" DataRangeYMin="0.2" DataRangeYMax="1.2"></PhChartLinear>
        </Template>
    </Story>

    <Story Name="Linear Chart - RU">
        <Template>
            <PhChartLinear Interactive="true" Content="ContentRU" ChartWidth="800" ChartHeight="500" DataRangeXMin="@_startDate3" DataRangeXMax="@_endDate3" DataRangeYMin="0" DataRangeYMax="20000"></PhChartLinear>
        </Template>
    </Story>

    <Story Name="Logarithmic Chart">
        <Template>
            <PhChartLogarithmic Interactive="true" Content="ContentLogarithmic" ChartWidth="716" ChartHeight="768" DataRangeXMin="1" DataRangeXMax="10000" DataRangeYMin="10" DataRangeYMax="100000"></PhChartLogarithmic>  
        </Template>
    </Story>

    <Story Name="Logarithmic Chart - miniature">
        <Template>
            <div style="padding-left:70px;">
                <PhChartLogarithmic Miniature="true" Content="ContentLogarithmicMiniature" ChartWidth="192" ChartHeight="140" DataRangeXMin="1" DataRangeXMax="10000" DataRangeYMin="10" DataRangeYMax="100000"></PhChartLogarithmic>
            </div>
        </Template>
    </Story>

    <Story Name="Logarithmic Chart - empty">
        <Template>
            <PhChartLogarithmic Interactive="true" Content="ContentLogarithmicEmpty" ChartWidth="716" ChartHeight="768" DataRangeXMin="1" DataRangeXMax="10000" DataRangeYMin="10" DataRangeYMax="100000"></PhChartLogarithmic>
        </Template>
    </Story>
</Stories>

