        _dynamicYMin += 0.1;
    }

    private void VerticalZoomOut()
    {
        _dynamicYMax += 0.1;
        _dynamicYMin -= 0.1;
    }

    private async Task Animate()
    {
        PhChartLinear.HorizontalLine line = new PhChartLinear.HorizontalLine
        {
            Value = 0.6,
            Label = true,
            Dashed = false,
            DrawTick = false
        };

        ContentDynamic.Add(line);

        var points = ContentDynamic.OfType<PhChartLinear.Points>().FirstOrDefault();
        var pointsYOriginal = points.PointList.Values.SelectMany(p => p).Select(p => p.Y).ToList();
        var rnd = new Random();
        var lastFewValues = new double[] { -1, 0.25, 0.35, 0.7, 1.05, 1.15, 1.5 };
        var lastFewCounter = 0;
        var latestCount = points.PointList.Count;
        var degree = 0.0;
        while (true)
        {
            if (!_animating)
            {
                await Task.Delay(1000);
                continue;
            }

            line.Value = 0.5 + 0.3 * Math.Sin(0.1 * degree);

            var count = points.PointList.Count;
            if (count != latestCount)
            {
                pointsYOriginal = points.PointList.Values.SelectMany(p => p).Select(p => p.Y).ToList();
                latestCount = count;
            }

            for (int j = 0; j < count; j++)
            {
                var p = points.PointList.Values.ElementAt(j)?[0];
                if (p == null)
                {
                    continue;
                }
                p.Active = Math.Sin(0.3 * (degree + j)) > 0;
                p.Selected = Math.Sin(0.2 * (degree + j)) > 0;
                var pyOriginal = pointsYOriginal[j];
                p.Y = pyOriginal + 0.1 * Math.Sin(j + degree);

                if (lastFewCounter < lastFewValues.Length)
                {
                    p.Y = lastFewValues[lastFewCounter];
                    lastFewCounter++;
                }
            }

            setPointStatus(points, regionsMultiple);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(10);
            degree += 0.02;
        }
    }

    private void AddPoint()
    {
        var rnd = new Random();
        var randNum = rnd.NextDouble();
        var points = ContentDynamic.OfType<PhChartLinear.Points>().First();
        var latestX = points.PointList.Values.LastOrDefault()?[0].X;
        var newP = new PhChartLinear.Point
            {
                X = (latestX ?? _startDate) + new TimeSpan(12, 0, 0),
                Y = 0.2 + randNum,
                Selected = randNum % 0.3 > 0.1,
                Active = randNum % 0.15 > 0.07
            };
        points.PointList.Add(newP.X, new List<Point> { newP });
        setPointStatus(points, regionsMultiple);
    }

    private void DeletePoint()
    {
        var points = ContentDynamic.OfType<PhChartLinear.Points>().First();
        if (points.PointList.Count > 0)
        {
            points.PointList.RemoveAt(points.PointList.Count - 1);
        }
    }

    private void AddLine()
    {
        var rnd = new Random();
        var randNum = rnd.NextDouble();

        if (randNum < 0.5)
        {
            var line = new PhChartLinear.HorizontalLine
                {
                    Value = 0.2 + randNum,
                    Label = true,
                    Dashed = true,
                    DrawTick = true
                };
            ContentDynamic.Add(line);
        }
        else
        {
            var line = new PhChartLinear.VerticalLine
                {
                    Value = _startDate + randNum * (_endDate - _startDate),
                    Dashed = true,
                };
            ContentDynamic.Add(line);
        }
    }

    private void DeleteLine()
    {
        var lineH = ContentDynamic.OfType<PhChartLinear.HorizontalLine>().LastOrDefault();
        var lineV = ContentDynamic.OfType<PhChartLinear.VerticalLine>().LastOrDefault();

        var rnd = new Random();
        var randNum = rnd.NextDouble();

        if (randNum < 0.5)
        {
            if (lineH != null)
            {
                ContentDynamic.Remove(lineH);
            }
            else if (lineV != null)
            {
                ContentDynamic.Remove(lineV);
            }
        }
        else
        {
            if (lineV != null)
            {
                ContentDynamic.Remove(lineV);
            }
            else if (lineH != null)
            {
                ContentDynamic.Remove(lineH);
            }
        }
    }

    private void AddRegion()
    {
        var rnd = new Random();
        var randNum = rnd.NextDouble();
        var start = _startDate;
        var end = start + new TimeSpan(48, 0, 0);

        var regions = ContentDynamic.OfType<PhChartLinear.Regions>().FirstOrDefault();
        if (regions == null)
        {
            regions = new PhChartLinear.Regions();
            ContentDynamic.Add(regions);
        }

        if (regions.RegionList.Count > 0)
        {
            start = regions.RegionList.Last().End;
            end = start + new TimeSpan(48, 0, 0);
        }

        var region = new PhChartLinear.Region
            {
                Start = start,
                End = end,
                LowerAlert = 0.2 + randNum * 0.2,
                LowerWarning = 0.4 + randNum * 0.2,
                UpperAlert = 0.9 + randNum * 0.2,
                UpperWarning = 0.7 + randNum * 0.2
            };

        regions.RegionList.Add(region);
    }

    private void DeleteRegion()
    {
        var regions = ContentDynamic.OfType<PhChartLinear.Regions>().LastOrDefault();
        if (regions != null)
        {
            if (regions.RegionList.Count > 0)
            {
                regions.RegionList.Remove(regions.RegionList.Last());
            }
        }
    }

    private PhChartLinear.Points randomizePointsLinear(int numPoints, DateTimeOffset startDate, TimeSpan deltaTime, double min, double max, double[]? lastFewValues = null)
    {
        var points = new PhChartLinear.Points();
        var rnd = new Random();
        var lastFewCounter = 0;
        for (var i = 0; i < numPoints; i++)
        {
            var p = new PhChartLinear.Point
            {
                X = startDate + i * deltaTime,
                Y = min + ((max - min) / 2.0) + (rnd.Next(0, 2) * 2 - 1) * Math.Pow(rnd.NextDouble(), 3) * ((max - min) / 2.0)
            };

            // Add specific values in four flavours (nothing special, selected, active, active selected)
            if (lastFewValues != null && i >= (numPoints - lastFewValues.Length * 4) && i < numPoints)
            {
                var y = lastFewValues[lastFewCounter];
                p.Y = y;

                if (i >= (numPoints - lastFewValues.Length * 3) && i < (numPoints - lastFewValues.Length * 2))
                {
                    p.Selected = true;
                }
                else if (i >= (numPoints - lastFewValues.Length * 2) && i < numPoints - lastFewValues.Length)
                {
                    p.Active = true;
                }
                else if (i >= (numPoints - lastFewValues.Length) && i < numPoints)
                {
                    p.Active = true;
                    p.Selected = true;
                }

                lastFewCounter++;

                if (lastFewCounter == lastFewValues.Length)
                {
                    lastFewCounter = 0;
                }
            }

            points.PointList.Add(p.X, new() { p });
        }

        return points;
    }

    private void setPointStatus(PhChartLinear.Points points, PhChartLinear.Regions regions)
    {
        foreach (var pList in points.PointList.Values)
        {
            foreach (var p in pList)
            {
                p.Status = PointStatus.normal;

                foreach (var region in regions.RegionList)
                {
                    if (p.X > region.Start && p.X < region.End)
                    {
                        if (p.Y > region.UpperAlert)
                        {
                            p.Status = PointStatus.alert;
                        }
                        else if (p.Y > region.UpperWarning)
                        {
                            p.Status = PointStatus.warning;
                        }
                        else if (p.Y < region.LowerAlert)
                        {
                            p.Status = PointStatus.alert;
                        }
                        else if (p.Y < region.LowerWarning)
                        {
                            p.Status = PointStatus.warning;
                        }

                        break;
                    }
                }
            }
        }
    }
}