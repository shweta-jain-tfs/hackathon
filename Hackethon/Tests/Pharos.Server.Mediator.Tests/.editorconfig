# severity levels: error, warning, suggestion, silent, none, default

# C# files
[*.cs]

# CA2000:
dotnet_diagnostic.CA2000.severity = none

# CA2016: Forward the 'cancellationToken' parameter to the method or pass in CancellationToken.None
dotnet_diagnostic.CA2016.severity = none

# CA2201: Exception type System.Exception is not sufficiently specific
dotnet_diagnostic.CA2201.severity = none

# CA2263: Prefer generic overload
dotnet_diagnostic.CA2263.severity = none

# IDE0044: Make field readonly
dotnet_diagnostic.IDE0044.severity = none

# IDE0052: Private member can be removed as the value assigned to it is never read
dotnet_diagnostic.IDE0052.severity = none

# IDE0130: Namespace does not match folder structure
dotnet_diagnostic.IDE0130.severity = none
