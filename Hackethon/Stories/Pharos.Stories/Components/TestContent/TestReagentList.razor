        new(
            "Cartridge Other",
            ReagentIndicatorShape.Slanted,
            [
                new("ImmunoCAP Diluent", ["#828386"]),
                new("EliA Diluent", ["#CDCED4"]),
                new("Development solution", ["#222223"])
