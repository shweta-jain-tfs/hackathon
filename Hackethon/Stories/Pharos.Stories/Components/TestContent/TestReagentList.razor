            ]),

        new(
            "Carriers",
            ReagentIndicatorShape.Round,
            [
                new("Phadiatop", ["#FF6719"]),
                new("Moulds & Yeast", ["#80A15F"]),
                new("Parasites", ["#F18D94"]),
                new("Miscellaneous", ["#243DAE"]),
                new("Epidermal & Animals", ["#F13326"]),
                new("Food", ["#33A1E4"]),
                new("Mites", ["#F13672"]),
                new("House dust", ["#8E9193"]),
                new("Drugs", ["#29AE5D"]),
                new("Weed pollen", ["#D6D12F"]),
                new("ECP-Anti-ECP", ["#F2F2F2"]),
