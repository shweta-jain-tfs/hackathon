@using Pharos.Common.Web.Components.Reagent
@using Pharos.Common.Web.Utilities

<div style="padding: 24px; @BackgroundStyle" class="flex flex-wrap gap-lg">
    @foreach (var group in _groups)
    {
        <div class="flex flex-col gap-gutter">
            <h2 class="t-body1">@group.Name</h2>
            @foreach (var reagent in group.Reagents)
            {
                <ReagentShapeView Shape="group.Shape" FriendlyName="@reagent.Name" Colors="@reagent.Colors" ContrastSurfaceOverride="Surface" />
            }
        </div>
    }

</div>

@code {
    [Parameter] public ContrastSurface Surface { get; set; } = ContrastSurface.Dark;

    private string BackgroundStyle => Surface switch
    {
        ContrastSurface.Light => "background-color: #F5F5F5; --ph-reagent-shape-outline: #000000; color: #000000",
        ContrastSurface.Print => "background-color: #FFFFFF; --ph-reagent-shape-outline: #000000; color: #000000",
        _ or ContrastSurface.Dark => "background-color: #1B1B1B",
    };

    private readonly ReagentGroup[] _groups =
    [
        new(
            "Cartridge Elia",
            ReagentIndicatorShape.Slanted,
            [
                new("El-G", ["#8DC8E8"]),
                new("El-M", ["#FCD1BA"]),
                new("El-A", ["#DBB6D6"]),
                new("El-T", ["#DBEBC1"]),
                new("El-GM (Japan)", ["#F5D9E8"]),
                new("El-C2", ["#34BDB0"]),
                new("El-A / El-M", ["#DBB6D6", "#FCD1BA"]),
                new("El-G / El-A / El-M", ["#8DC8E8", "#DBB6D6", "#FCD1BA"]),
                new("El-G / El-A", ["#8DC8E8", "#DBB6D6"]),
                new("El-G / El-GM", ["#8DC8E8", "#F5D9E8"]),
                new("El-G / El-T", ["#8DC8E8", "#DBEBC1"]),
                new("EliA 3+ method", ["#F8EEA3"])
            ]),

        new(
            "Cartridge ImmunoCAP",
            ReagentIndicatorShape.Slanted,
            [
                new("tIgE", ["#126448"]),
                new("sIgE", ["#842573"]),
                new("sIgG4", ["#66BD52"]),
                new("sIgG", ["#DA6A27"]),
                new("View allergy (Japan)", ["#0B8ABB"]),
                new("Tryptase", ["#18557C"]),
                new("ECP", ["#881737"]),
                new("sIgG / sIgG4", ["#DA6A27", "#66BD52"])
