@code
{
    private int _highlightedId = 10;
    private List<DefaultDataGridItem> _data = new();
    private IQueryable<DefaultDataGridItem>? _dataForDateTimeGrid;
    private IEnumerable<object> _preSelectedIds = [];
    private bool _isExpanded;
    private PhDataGrid<DefaultDataGridItem>? _refDgSetISelectedItems = default!;
    private List<DefaultDataGridItem> _setSelectedItems = [];
    private bool _disposed;
    private readonly CustomQuickFilter[] _fibonacciQuickFilters =
    [
        new(new FibonacciIdFilter(nameof(DefaultDataGridItem.Id)), typeof(FibonacciQuickFilterView))
    ];
    private readonly CustomQuickFilter[] _fibonacciPhQuickFilters =
    [
        new(new FibonacciIdsFilter(nameof(DefaultDataGridItem.Id)), typeof(FibonacciPhQuickFilterView))
    ];
    private readonly CustomQuickFilter[] _fibonacciQuickFiltersAtEnd =
    [
        new(new FibonacciIdFilter(nameof(DefaultDataGridItem.Id)), typeof(FibonacciQuickFilterView))
        {
            Position = CustomQuickFilterPosition.End
        }
    ];
    private ItemStyleFlags _demoItemStyleFlags = ItemStyleFlags.None;
    private readonly IQueryable<DefaultDataGridItem> _allItemStyleRows = new[]
    {
        (ItemStyleFlags.None, "Normal row with an enabled checkbox."),
        (ItemStyleFlags.Disabled, "Dimmed row with a disabled checkbox."),
        (ItemStyleFlags.Checked, "Checked checkbox; row is not selected."),
        (ItemStyleFlags.Dimmed, "Dimmed row with an enabled checkbox."),
        (ItemStyleFlags.CheckboxDisabled, "Normal row with a disabled checkbox."),
        (ItemStyleFlags.CheckboxHidden, "Normal row without a checkbox."),
        (ItemStyleFlags.Disabled | ItemStyleFlags.Checked, "Dimmed row with a disabled, checked checkbox."),
        (ItemStyleFlags.CheckboxDisabled | ItemStyleFlags.Checked, "Normal row with a disabled, checked checkbox."),
        (ItemStyleFlags.Dimmed | ItemStyleFlags.CheckboxHidden, "Dimmed row without a checkbox.")
    }.Select(option => new DefaultDataGridItem
    {
        Id = (int)option.Item1,
        Firstname = option.Item1.ToString(),
        Description = option.Item2
    }).AsQueryable();
    private int _itemStyleSelectedCount;
    private readonly IQueryable<DefaultDataGridItem> _itemStyleDemoRows = new[]
    {
        new DefaultDataGridItem { Id = 1, Firstname = "Normal row", Description = "No" },
        new DefaultDataGridItem { Id = 2, Firstname = "Styled row", Description = "Yes" },
        new DefaultDataGridItem { Id = 3, Firstname = "Another styled row", Description = "Yes" }
    }.AsQueryable();
    private readonly (ItemStyleFlags Flag, string Description)[] _itemStyleFlagOptions =
    [
        (ItemStyleFlags.Disabled, "Dims the row and disables its selection checkbox."),
        (ItemStyleFlags.Checked, "Shows a checked checkbox without changing the actual selection."),
        (ItemStyleFlags.Dimmed, "Dims the row while keeping its selection checkbox enabled."),
        (ItemStyleFlags.CheckboxDisabled, "Disables the selection checkbox without dimming the row."),
        (ItemStyleFlags.CheckboxHidden, "Hides the selection checkbox without dimming the row.")
    ];

    private void SetDemoItemStyleFlag(ItemStyleFlags flag, bool isChecked)
    {
        _demoItemStyleFlags = isChecked ? _demoItemStyleFlags | flag : _demoItemStyleFlags & ~flag;
    }

    protected override void OnInitialized()
    {
        //If you need a new JSON file to test data against use this.
        //I was a bit lazy so you have to add a break point and copy the text in the json var and paste it in wwwroot/FakeApiData/DefaultDataGrid.json
        // GenerateJsonFile();

        navManager.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Safe to interact with DOM or load data
            _data = await LoadData();
            _dataForDateTimeGrid = LoadDataForDateTimeGrid().AsQueryable();
            _preSelectedIds = LoadPreSelectedIds();
        }
        
        if (_refDgSetISelectedItems is not null && _setSelectedItems is {Count: 0})
        {
            SetSelectedItems();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed)
        {
            return;
        }

        // In Blazing Story the story component instance can be reused.
        // Reset so the "Set Items Selected" story runs again when navigating back.
        _setSelectedItems.Clear();

        _ = InvokeAsync(StateHasChanged);
    }

    private void HighlightedChanged(DefaultDataGridItem? item)
    {
        _highlightedId = item?.Id ?? -1;
    }

    private IEnumerable<object> LoadPreSelectedIds()
    {
        return [1, 2, 3, 5, 7, 9];
    }

    private async ValueTask<GridItemsProviderResult<DefaultDataGridItem>> LoadMixedDescriptionsData(GridItemsProviderRequest<DefaultDataGridItem> request)
    {
        return await LoadData(request, "/FakeApiData/MixedDescriptionsDataGrid.json");
    }

    private async ValueTask<GridItemsProviderResult<DefaultDataGridItem>> LoadGroupedData(GridItemsProviderRequest<DefaultDataGridItem> request)
    {
        return await LoadData(
            request,
            "/FakeApiData/GroupedDataGrid.json",
            groupedCountFunc: items =>
            {
                // simulate a server-provided GroupedCount
                var groups = 0;
                string? last = null;

                foreach (var item in items)
                {
                    if (!string.Equals(item.Firstname, last, StringComparison.Ordinal))
                    {
                        groups++;
                        last = item.Firstname;
                    }
                }

                return groups;
            });
    }

    private async ValueTask<GridItemsProviderResult<DefaultDataGridItem>> LoadData(GridItemsProviderRequest<DefaultDataGridItem> request)
    {
        return await LoadData(request, "/FakeApiData/DefaultDataGrid.json");
    }

    private async ValueTask<GridItemsProviderResult<DefaultDataGridItem>> LoadData(
        GridItemsProviderRequest<DefaultDataGridItem> request,
        string dataFile,
        Func<IReadOnlyList<DefaultDataGridItem>, int?>? groupedCountFunc = null)
    {
        List<DefaultDataGridItem> result;

        try
        {
            result = await httpClient.GetFromJsonAsync<List<DefaultDataGridItem>>(dataFile) ?? [];
        }
        catch
        {
            return GridItemsProviderResult.From([new DefaultDataGridItem
            {
                Id = -1,
                Firstname = dataFile,
                Lastname = "could not be loaded"
            }], 1);
        }

        if (result.Count == 0)
        {
            return GridItemsProviderResult.From(result, 0);
        }

        // Apply all column filters
        foreach (var filter in request.ColumnFilters ?? [])
        {
            // Multi-select filters (e.g. checkboxes) use OR: keep rows matching any selected value.
            if (filter.PropertyName == nameof(DefaultDataGridItem.Id)
                && filter.LogicalOperator == LogicalFilterOperator.Or)
            {
                var ids = filter.FilterExpressions
                    .OfType<PropertyFilterExpression<int>>()
                    .Select(x => x.Value)
                    .ToHashSet();

                if (ids.Count > 0)
                {
                    result = result.Where(x => ids.Contains(x.Id)).ToList();
                }

                continue;
            }

            foreach (var expression in filter.FilterExpressions)
            {
                switch (filter.PropertyName)
                {
                    case nameof(DefaultDataGridItem.Firstname):
                        if (expression.UntypedValue is string firstnameValue && !string.IsNullOrEmpty(firstnameValue))
                        {
                            result = result.Where(x => x.Firstname != null && x.Firstname.Contains(firstnameValue, StringComparison.OrdinalIgnoreCase)).ToList();
                        }
                        break;

                    case nameof(DefaultDataGridItem.Lastname):
                        if (expression.UntypedValue is string lastnameValue && !string.IsNullOrEmpty(lastnameValue))
                        {
                            result = result.Where(x => x.Lastname != null && x.Lastname.Contains(lastnameValue, StringComparison.OrdinalIgnoreCase)).ToList();
                        }
                        break;

                    case nameof(DefaultDataGridItem.Id):
                        if (expression is PropertyFilterExpression<int> { Value: var idValue })
                        {
                            result = result.Where(x => x.Id == idValue).ToList();
                        }
                        break;
                    case nameof(DefaultDataGridItem.HasLongFirstName):
                        if (expression.UntypedValue is bool boolValue)
                        {
                            result = result.Where(x => x.HasLongFirstName == boolValue).ToList();
                        }
                        break;
                }
            }
        }

        var totalCount = result.Count;

        if (request.SortByColumn != null)
        {
            var sortProp = typeof(DefaultDataGridItem).GetProperty(request.SortByColumn);
            if (sortProp != null)
            {
                if (request.SortByAscending)
                {
                    result = result.OrderBy(x => sortProp.GetValue(x, null)).ToList();
                }
                else
                {
                    result = result.OrderByDescending(x => sortProp.GetValue(x, null)).ToList();
                }
            }
        }

        var groupedCount = groupedCountFunc?.Invoke(result);

        result = result.Skip(request.StartIndex).Take(request.Count ?? 9999).ToList();

        return new GridItemsProviderResult<DefaultDataGridItem>
            {
                Items = result,
                TotalItemCount = totalCount,
                GroupedCount = groupedCount,
            };
    }

    private async ValueTask<List<DefaultDataGridItem>> LoadData()
    {
        var result = await httpClient.GetFromJsonAsync<List<DefaultDataGridItem>>("/FakeApiData/DefaultDataGrid.json");

        return result!;
    }

    private List<DefaultDataGridItem> LoadDataForDateTimeGrid()
    {
        var rows = new List<DefaultDataGridItem>();

        for (int i = 0; i < 20; i++)
        {
            var faker = new Faker<DefaultDataGridItem>()
                .RuleFor(u => u.DateAndTimeOfBirth, f => f.Date.PastOffset(60, DateTime.Now.AddYears(-18)).DateTime)
                .RuleFor(u => u.Firstname, f => f.Person.FirstName)
                .RuleFor(u => u.Lastname, f => f.Person.LastName);

            rows.Add(faker);
        }

        return rows;
    }
    

