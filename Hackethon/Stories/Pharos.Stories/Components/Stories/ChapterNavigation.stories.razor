@using BlazingStory.Abstractions
@using Pharos.Common.Web.Components.ChapterNavigation
@using Pharos.Common.Web.Components.Layout
@using Pharos.Common.Web.Components.RichText
@attribute [Stories("Components/ChapterNavigation")]

<Stories TComponent="PhChapterNav">
    <Story Name="User manual with subchapters">
        <Description>
            Interactive chapter navigation with several documents. The top level are different "documents".
        </Description>
        <Arguments>
            <Arg For="_ => _!.WithBackground" Value="false" />
            <Arg For="_ => _!.PreventNavigation" Value="true" />
        </Arguments>
        <Template>
            <div style="max-width: 355px;">
                <p class="mb-md">
                    <strong>Current chapter:</strong> @_currentChapterId
                </p>
                <PhChapterNav @attributes="context.Args"
                              Items="@_documentationItems"
                              CurrentChapterId="@_currentChapterId"
                              OnNavigate="@HandleNavigate" />
            </div>
        </Template>
    </Story>

    <Story Name="User manual with pre-selected chapter">
        <Description>
            Pre-selected chapter from parameter.
        </Description>
        <Arguments>
            <Arg For="_ => _!.CurrentChapterId" Value="@("operating-loading-bottled")" />
            <Arg For="_ => _!.WithBackground" Value="false" />
            <Arg For="_ => _!.PreventNavigation" Value="true" />
        </Arguments>
        <Template>
            <div style="max-width: 355px;">
                @{
                    var chapter = GetCurrentChapter(context, _currentChapterId);
                }
                <p>Use clicked chapter by clearing <em>@nameof(PhChapterNav.CurrentChapterId)</em>.</p>
                <p class="my-md">
                    <strong>Current chapter:</strong> @chapter
                    @if (_currentChapterId != chapter)
                    {
                        <div>
                            <strong>Clicked chapter:</strong> @_currentChapterId
                        </div>
                    }
                </p>
                <PhChapterNav @attributes="context.Args"
                Items="@_documentationItems"
                CurrentChapterId="@chapter"
                OnNavigate="@HandleNavigate" />
            </div>
        </Template>
    </Story>

    <Story Name="Deep nesting example">
        <Description>
            Example with deeper structure than the user manual.
        </Description>
        <Arguments>
            <Arg For="_ => _!.WithBackground" Value="false" />
            <Arg For="_ => _!.PreventNavigation" Value="true" />
        </Arguments>
        <Template>
            <div style="max-width: 355px;">
                <p class="mb-md">
                    <strong>Current chapter:</strong> @_currentDeepChapterId
                </p>
                <PhChapterNav @attributes="context.Args"
                Items="@_deepItems"
                CurrentChapterId="@GetCurrentChapter(context, _currentDeepChapterId)"
                OnNavigate="@HandleNavigateDeep" />
            </div>
        </Template>
    </Story>

    <Story Name="User manual without container">
        <Description>
            No fixed width around the chapter navigation.
        </Description>
        <Arguments>
            <Arg For="_ => _!.WithBackground" Value="false" />
            <Arg For="_ => _!.PreventNavigation" Value="true" />
        </Arguments>
        <Template>
            <PhChapterNav @attributes="context.Args"
            Items="@_documentationItems"
            CurrentChapterId="@_currentChapterId"
            OnNavigate="@HandleNavigate" />
        </Template>
    </Story>

    <Story Name="In sidebar">
        <Description>
            Chapter navigation placed inside a page sidebar.
        </Description>
        <Arguments>
            <Arg For="_ => _!.WithBackground" Value="true" />
            <Arg For="_ => _!.PreventNavigation" Value="true" />
        </Arguments>
        <Template>
            <div style="height: 100vh">
                <PhPage WideSidebar>
                    <Sidebar>
                        <PhChapterNav @attributes="context.Args"
                        Items="@_documentationItems"
                        CurrentChapterId="@_currentChapterId"
                        OnNavigate="@HandleNavigate" />
                    </Sidebar>
                    <ChildContent>
                        <PhRichText>
                            @{
                                (var docTitle, var chapterTitle) = GetTitles(_currentChapterId);
                            }
                            <h1>@docTitle</h1>
                            @if(docTitle != chapterTitle)
                            {
                                <h2>@chapterTitle</h2>
                            }
                            <p>
                                Click the chapter navigation to select the document and chapter.
                            </p>
                        </PhRichText>
                    </ChildContent>
                </PhPage>
            </div>
        </Template>
    </Story>

</Stories>

