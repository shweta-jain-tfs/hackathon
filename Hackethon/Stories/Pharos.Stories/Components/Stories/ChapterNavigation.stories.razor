    private void HandleNavigate(string chapterId)
    {
        _currentChapterId = chapterId;

        // In a real application, this would trigger navigation
        Console.WriteLine($"Navigating to chapter: {chapterId}");
    }

    private void HandleNavigateDeep(string chapterId)
    {
        _currentDeepChapterId = chapterId;

        // In a real application, this would trigger navigation
        Console.WriteLine($"Navigating to chapter: {chapterId}");
    }

    private string? GetCurrentChapter(IStoryContext context, string? fallback)
    {
        const string propertyName = nameof(PhChapterNav.CurrentChapterId);

        // Check if CurrentChapterId is provided in context.Args
        if (context.Args?.ContainsKey(propertyName) == true)
        {
            var value = context.Args[propertyName]?.ToString();
            if (!string.IsNullOrEmpty(value))
            {
                return value;
            }
        }

        // Fall back to the provided value
        return fallback;
    }

    private (string docTitle, string chapterTitle) GetTitles(string? chapterId)
    {
        if (string.IsNullOrEmpty(chapterId))
        {
            return ("No document selected", "No chapter selected");
        }

        foreach (var doc in _documentationItems)
        {
            var found = FindChapter(doc, chapterId);
            if (found != null)
            {
                return (doc.Title, found.Title);
            }
        }

        return ("Unknown document", "Unknown chapter");
    }

    private ChapterNode? FindChapter(ChapterNode node, string chapterId)
    {
        if (node.Id == chapterId)
        {
            return node;
        }

        foreach (var child in node.Children)
        {
            var found = FindChapter(child, chapterId);
            if (found != null)
            {
                return found;
            }
        }

        return null;
    }
