@using Pharos.Common.Web.Components.MaintenanceCard
@using Pharos.Common.Web.Components.TabControl
@attribute [Stories("Components/MaintenanceCard")]

<Stories TComponent="PhMaintenanceCard">
    <Story Name="Single card">
        <Template>
            <PhMaintenanceCard Name="Card Name" ImageUrl="https://picsum.photos/id/237/208/240" Description="This is a description of the maintenance card." @attributes="context.Args" />
        </Template>
    </Story>
    <Story Name="Card list">
        <Template>
            <PhMaintenanceCardList>
                <PhMaintenanceCard Name="Card Name" Description="This is a description of the maintenance card." ImageUrl="@monthlyImage" @attributes="context.Args" />
                <PhMaintenanceCard Name="Card Name 2" Description="This is a description of the maintenance card. Longer text to make sure that the cards align." />
                <PhMaintenanceCard Name="Card Name 3" Description="For testing wrapping" />
            </PhMaintenanceCardList>
        </Template>
    </Story>
    <Story Name="Example">
        <Template>
            <div style="height: 100vh">
                <PhTabControl>
                    <PhTabPage Text="Scheduled">
                        <PhMaintenanceCardList>
                            <PhMaintenanceCard Name="Monthly maintenance"
                                ImageUrl="@monthlyImage"
                                Description="Extensive and automatic cleaning process that eliminates growth within the liquid system using Phadia Maintenance Solution."
                                DurationLabel="Duration:"
                                Duration="45 min"
                                LastCompleted="@DateTimeOffset.Now.AddDays(-7)"
                                LastCompletedLabel="Previous:"
                                Next="@DateTimeOffset.Now.AddDays(1)"
                                NextLabel="Next:"
                                Status="@MaintenanceCardStatus.Warning"
                                StatusText="Due within 3 days"
                                @attributes="context.Args" />
                            <PhMaintenanceCard Name="Manual cleaning"
                                ImageUrl="@manualImage"
                                Description="A set of maintenance activities to perform on a regular basis. Requires hands on activities."
                                DurationLabel="Estimated time:"
                                Duration="30 min"
                                LastCompleted="@DateTimeOffset.Now.AddDays(-8)"
                                LastCompletedLabel="Previous:"
                                Next="@DateTimeOffset.Now.AddDays(2)"
                                NextLabel="Next:" />
                        </PhMaintenanceCardList>
                    </PhTabPage>
                </PhTabControl>
            </div>
        </Template>
    </Story>

</Stories>

