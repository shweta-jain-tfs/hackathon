@using Pharos.Common.Web.Models.DataGrid
@attribute [Authorize]

<PhModalContent SelectedText="@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_Selected"]">
    <Body>
        <PhDataGrid TableTitle="@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_GridTitle"]" TGridItem="MethodTest"
                    StateID=""
                    ItemsProvider="ViewModel.ProvideGridItems"
                    SelectionType="SelectionTypeEnum.MultiSelect"
                    RowType="RowTypeEnum.LinesBetweenRows"
                    OnSelectedItemsChanged="SelectedTestsChanged"
                    DefaultSortColumn="MethodName"
                    DefaultSortDirection="SortDirection.Ascending"
                    ItemStyleOptions="@(new() {
                        Style = ItemStyleFlags.Checked | ItemStyleFlags.Disabled,
                        Match = MatchesTestOrderTest,
                        Items = CurrentTestOrders
                    })"
                    >
            <Columns>
                <Column Title="@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_Method"]" Property="@(item => item!.MethodName)" QuickFilter="true" Sortable="true" MultiSelectFilterItems="_methodList" />
                <Column Title="@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_Test"]" Property="@(item => item!.TestName)" QuickFilter="true" />
                <Column Title="@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_TestFullName"]" Property="@(item => item!.FullTestName)" QuickFilter="true" />
            </Columns>
        </PhDataGrid>
    </Body>
    <Footer>
        <PhButton OnClick="@(() => CloseModal(ModalResult.Cancel()))">@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_Cancel"]</PhButton>
        <PhButton Type="ButtonType.Primary" Disabled="!(_selectedItems?.Count > 0)" OnClick="@(() => CloseModal(ModalResult.Ok(_selectedItems)))">@Loc["ReflexDefinitionDetailPage_TestListView_TestAddView_Add"]</PhButton>
    </Footer>
</PhModalContent>