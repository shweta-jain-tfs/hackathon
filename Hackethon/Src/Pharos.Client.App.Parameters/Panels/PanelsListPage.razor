@using Pharos.Client.App.Parameters.Layout
@using Pharos.Client.Common.App.Auth
@using Pharos.Contracts.Security
@using Pharos.Common.Web.Models.DataGrid
@layout ParametersLayout
@attribute [Route(PageRoute.Parameters.TestPanels)]

<SectionContent SectionName="page-header">
    <Breadcrumb Items="@Breadcrumbs" />
</SectionContent>

<PhDockedButtonRow>
    <ChildContent>
        <PhDataGrid TableTitle="@Loc["TestPanelPage_Header"]"
                    @ref="_dataGrid"
                    StateID="panels"
                    TGridItem="MethodPanel"
                    ItemsProvider="ViewModel.ProvideGridItems"
                    SelectionType="@(IsEditingDisabled ? SelectionTypeEnum.Off : SelectionTypeEnum.MultiSelectWithSelectAll)"
                    OnSelectedItemsChanged="SelectedItemsChanged">
            <Columns>
                <Column Title="@Loc["TestPanelPage_Panel"]" Property="@(x => x.PanelName)">
                    <PhHrefLink Href="@($"{PageRoute.Parameters.TestPanelDetails.Default}/{context.Id}")">@context.PanelName</PhHrefLink>
                </Column>
                <Column Title="@Loc["TestPanelPage_LongName"]" Property="@(x => x.PanelLongName)" />
                <Column Title="@Loc["TestPanelPage_Grouped"]" Property="@(x => x.Grouped)">
                    @(context.Grouped ? Loc["TestPanelPage_Yes"] : Loc["TestPanelPage_No"])
                </Column>
                <Column Title="@Loc["TestPanelPage_Enabled"]" Property="@(x => x.Enabled)">
                    @(context.Enabled ? Loc["TestPanelPage_Yes"] : Loc["TestPanelPage_No"])
                </Column>
            </Columns>
        </PhDataGrid>
    </ChildContent>
    <Buttons>
        <PhAuthorize Permission="@Permissions.EditSystemSettings">
            <PhButton Type="ButtonType.Secondary" OnClick="AddPanel">@Loc["TestPanelPage_Add"]</PhButton>
            <PhButton Type="ButtonType.Secondary" Disabled="!HasSelectedItems" OnClick="DeleteSelectedPanels">@Loc["TestPanelPage_Delete"]</PhButton>
        </PhAuthorize>
    </Buttons>

</PhDockedButtonRow>
