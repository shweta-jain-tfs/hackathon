@using Pharos.Contracts.Security
@attribute [Route(AccountRoutes.ChangePassword + "{username}")]

<div class="ph-server-page">

    <section>
        <EditForm Model="this" method="post" OnValidSubmit="OnSubmit" FormName="login">
            <input type="hidden" name="RetryTicket" value="@RetryTicket" />
            <DataAnnotationsValidator />
            <div class="ph-server-page__content">
                <div class="ph-server-page__header">
                    <h1 class="t-h1">@Translations.ChangePassword_Title</h1>
                </div>
                <PhTextBox  Id="@nameof(NewPassword)"
                            @bind-Value="NewPassword"
                            Label="@Translations.ChangePassword_NewPassword"
                            Type="TextBoxType.Password"
                            Size="TextBoxSize.Default"
                            Error="@_newPasswordHasError"
                            autofocus="@(_newPasswordHasError || !_confirmationPasswordHasError)"/>

                <PhTextBox Id="@nameof(ConfirmationPassword)"
                           @bind-Value="ConfirmationPassword"
                           Label="@Translations.ChangePassword_ConfirmPassword"
                           Type="TextBoxType.Password"
                           Size="TextBoxSize.Default"
                           Error="@_confirmationPasswordHasError"
                           autofocus="@(!_newPasswordHasError && _confirmationPasswordHasError)" />

                @if (ChangeFailed)
                {
                    <p class="text-warning">@_errorMessage</p>
                }

                @if (UserManager.PasswordComplexityDisplayList.Any())
                {
                    <PhValueBox Size="TextBoxSize.Default">
                        @foreach (var complexityString in UserManager.PasswordComplexityDisplayList)
                        {
                            @complexityString
                            @if (complexityString != UserManager.PasswordComplexityDisplayList.Last())
                            {
                                <br />
                            }
                        }
                    </PhValueBox>
                }

                <div class="ph-server-page__footer">
                    <a href="/" class="ph-button ph-button--secondary ph-button--no-max-width">@Translations.Login_CancelButton</a>
                    <PhButton ButtonType="submit" Type="ButtonType.Primary">@Translations.Login_LoginButton</PhButton>
                </div>
            </div>
        </EditForm>
    </section>

</div>

@if (ChangeFailed)
{
    <CleanupError FieldId1="@nameof(NewPassword)" FieldId2="@nameof(ConfirmationPassword)" />
}
