{
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "",
    "Audit": ""
    // Set your connection string in appsettings.Development.json
    //"Default": "Server=localhost;TrustServerCertificate=True;Trusted_Connection=True;Database=Pharos;MultipleActiveResultSets=True;Column Encryption Setting=Enabled;Attestation Protocol=None;"
    //"Audit": "Server=localhost;TrustServerCertificate=True;Trusted_Connection=True;Database=AuditTrail;MultipleActiveResultSets=True;"
  },

  "Certificates": {
    "DefaultServerName": "localhost"
  },

  "Kestrel": {
    "EndpointDefaults": {
      "SslProtocols": [ "Tls12", "Tls13" ]
    },
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5128"
      },
      "Https": {
        "Url": "https://localhost:7042"
      }
    }
  },

  "Grpc": {
    "MainService": {
      "Port": 9876,
      "UseHttps": true,
      "RequireClientCertificate": true
    },
    "PairingService": {
      "Port": 9875,
      "PairingModeTimeoutSeconds": 120
    }
  },

  "DataProtection": {
    "EnableDataProtection": true
  },

  "LabCommunityDefaultConfiguration": {
    "CheckInIntervalSeconds": 120,
    "SystemStatusEnabled": true,
    "SystemStatusIntervalSeconds": 300,
    "ReportInstrumentErrorsIntervalSeconds": 30,
    "ReportCalibrationAndQualityResultsIntervalSeconds": 30,
    "ExportQueueCleanupIntervalDays": 1,
    "DeleteExportItemsOlderThanDays": 90
  },

  "Serilog": {
    "Using": [
      "Serilog.Expressions",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Default": "Information",
        "Microsoft": "Warning",
        "System": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Grpc": "Warning",
        "Quartz": "Information"
      }
    },
    "Properties": {
      "Application": "Pharos Server"
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "WriteTo": [
                    {
                      "Name": "Console",
                      "Args": {
                        "outputTemplate": "{Timestamp:HH:mm:ss}|{Level:u3}|{Message}|{Notification}{Command}{NewLine}{Exception}",
                        "restrictedToMinimumLevel": "Information",
                        "includesScopes": true
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "%PROGRAMDATA%\\Thermo Fisher Scientific\\Pharos\\Logs\\pharos-log-.txt",
                        "formatter": {
                          "type": "Serilog.Templates.ExpressionTemplate, Serilog.Expressions",
                          "template": "{ {@t, @l: if @l = 'Information' then undefined() else if @l = 'Verbose' then 'Trace' else @l, @tr, @sp, @sc: SourceContext, @mt, @x, ..@p, SourceContext: undefined(), Application: undefined(), EventId: undefined()} }\n"
                        },
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": null,
                        "rollOnFileSizeLimit": true,
                        "restrictedToMinimumLevel": "Information",
                        "includesScopes": true
                      }
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  }
}
