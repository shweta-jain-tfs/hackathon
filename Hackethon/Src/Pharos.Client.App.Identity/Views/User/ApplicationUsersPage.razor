@using Pharos.Client.App.Identity.ViewModels
@layout UsersAndRolesLayout
@attribute [Route(PageRoute.UsersAndRoles.Users)]
@attribute [Authorize(Permissions.ManageUsersAndRoles)]

<SectionContent SectionName="page-header">
    <Breadcrumb Items="@Breadcrumbs" />
</SectionContent>

<PhStack>
    <PhDockedButtonRow>
        <ChildContent>
            <PhDataGrid @ref="_phDataGrid" 
                        TableTitle="@Loc["ApplicationUsers_Users"]"
                        StateID="users"
                        TGridItem="ApplicationUserViewModel"
                        Items="@ViewModel.AsQueryable()"
                        SelectionType="SelectionTypeEnum.MultiSelect"
                        ItemStyleOptions="@(new() {
                            Style = ItemStyleFlags.Disabled,
                            Match = MatchesDisabledUser,
                            Items = _disableUsers
                        })"
                        OnSelectedItemsChanged="SelectedUserChanged">
                <Columns>
                    <Column Title="@Loc["ApplicationUsers_UserName"]" Property="@(x => x.Model.UserName)">
                        <PhHrefLink Href="@($"{PageRoute.UsersAndRoles.UserDetails.Default}/{context?.Model.Id}")">@context?.Model.UserName</PhHrefLink>
                    </Column>
                    <Column Title="@Loc["ApplicationUsers_Fullname"]" Property="@(x => x.Model.FullName)" />
                    <Column Title="@Loc["ApplicationUsers_RoleName"]" Property="@(x => x.Model.Role)">
                        @(context.Model.Role?.DisplayName ?? "-")
                    </Column>
                    <Column Title="@Loc["ApplicationUsers_Status"]" Property="@(x => x.Model.LockoutEnabled)">
                        @GetStatus(context.Model)
                    </Column>
                    <Column Title="@Loc["ApplicationUsers_LastLoginDateTimeOffset"]" Property="@(item => item.Model.LastLoginDateTimeOffset)">
                        <PhDateTimeDifference DateTimeDifferencePoint="@context.Model.LastLoginDateTimeOffset" DateTimeStartPoint="DateTime.Now" TextFallback="@Loc["ApplicationUsers_NeverLoggedIn"]"></PhDateTimeDifference>
                    </Column>
                </Columns>
            </PhDataGrid>
        </ChildContent>
        <Buttons>
            <PhButton Type="ButtonType.Secondary" Disabled="@(!_isDeleteAvailable)" OnClick="DeleteUsers">
                @Loc["ApplicationUsers_Delete"]
            </PhButton>
            <PhButton OnClick="AddUserButtonClicked">
                @Loc["ApplicationUsers_Add"]
            </PhButton>
        </Buttons>
    </PhDockedButtonRow>
</PhStack>